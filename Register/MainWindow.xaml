<Window x:Class="EmailSender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmailSender"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Margin="5" FontWeight="Bold" FontSize="15">From whom --></Label>
            <TextBlock Margin="5" Grid.Column="1" x:Name="TextBlockFrom"></TextBlock>
            <Label Margin="5" FontWeight="Bold" FontSize="15" Grid.Row="1">To whom --></Label>
            <TextBox VerticalContentAlignment="Center" x:Name="ToWhom" Margin="5" Grid.Row="1" Grid.Column="1"></TextBox>
            <Label Margin="5" FontWeight="Bold" FontSize="15" Grid.Row="2">Theme --></Label>
            <TextBox VerticalContentAlignment="Center" x:Name="Theme" Margin="5" Grid.Row="2" Grid.Column="1"></TextBox>
        </Grid>
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button  FontSize="15" Background="Aqua" Margin="10" VerticalAlignment="Top" Width="200" Height="40" Click="AttachedFile">Attach a file</Button>
            <TextBlock FontSize="15" Margin="5" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="1">List of attached files</TextBlock>
            <ListBox x:Name="ListAttachedFile" Width="500" Height="150" Grid.Row="2" ></ListBox>
        </Grid>
        <Button Margin="5" Width="250" FontSize="25" Background="GreenYellow" FontWeight="Bold" DockPanel.Dock="Top" Click="Write_Message_Button">Write Message</Button>
    </DockPanel>
</Window>
