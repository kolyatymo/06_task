<Window x:Class="EmailSender.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmailSender"
        mc:Ignorable="d"
        Title="Register" Height="250" Width="500">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label FontSize="15">Write Gmail --></Label>
            <TextBox x:Name="Gmail" Grid.Column="1" Margin="10,2,10,2" VerticalContentAlignment="Center"></TextBox>
            <Label FontSize="15" Grid.Row="1">Write App passwords --></Label>
            <TextBox x:Name="AppPassword" Grid.Row="1" Margin="10,2,10,2" VerticalContentAlignment="Center" Grid.Column="1"></TextBox>
        </Grid>
        <Button  FontWeight="Bold" FontSize="20" Margin="0,30,0,0" VerticalAlignment="Top" Width="70" Height="60" Background="GreenYellow" Click="Button_Next">Okay</Button>
    </DockPanel>
</Window>
